;

  const importBtn = document.getElementById('importBtn');
  const statusEl = document.getElementById('status');

  importBtn.addEventListener('click', async () => {
    statusEl.className = 'status';
    statusEl.textContent = 'Checking for existing games…';
    importBtn.disabled = true;

    try {
      const snap = await getDoc(DOC_REF);
      const existingList = snap.exists() ? (snap.data().list || []) : [];

      if (existingList.length > 0) {
        const proceed = confirm(
          `The games list already has ${existingList.length} game(s) in it.\n\n` +
          `Importing will ADD ${legacyGames.length} more on top of those — ` +
          `if you've already run this before, that means duplicates.\n\nContinue anyway?`
        );
        if (!proceed) {
          statusEl.className = 'status warn';
          statusEl.textContent = 'Import cancelled.';
          importBtn.disabled = false;
          return;
        }
      }

      statusEl.textContent = 'Uploading…';
      const updatedList = [...existingList, ...legacyGames];
      await setDoc(DOC_REF, { list: updatedList });

      statusEl.className = 'status ok';
      statusEl.textContent = `Done! Imported ${legacyGames.length} games (${updatedList.length} total now).\nYou can now delete this file and use sfc-admin.html from here on.`;
    } catch (err) {
      console.error(err);
      statusEl.className = 'status err';
      statusEl.textContent = 'Import failed — check your Firestore rules allow writes for logged-in users, and check your connection.';
    } finally {
      importBtn.disabled = false;
    }
  });
</script>
</body>
</html>
