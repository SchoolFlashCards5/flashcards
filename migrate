  const firebaseConfig = {
    apiKey: "AIzaSyC3jxwyH9Pws4nhIT9ScDffk5CpHa99oMM",
    authDomain: "pinkgame-1d4bf.firebaseapp.com",
    projectId: "pinkgame-1d4bf",
    storageBucket: "pinkgame-1d4bf.firebasestorage.app",
